package component

import (
    "fmt"
)

templ GlobalErrorComponent(message string) {
    <div class="flex items-center fade-out p-4 m-4 bg-error rounded-xl shadow-3xl fixed top-10 inset-x-0 w-3/4 mx-auto text-4xl" id="global-error" role="alert" hx-swap-oob="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="text-error-content stroke-current shrink-0 h-12 w-12 mr-2 justify-self-center" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span class="text-error-content">{message}</span>
    </div>
}

templ PageWrapperComponent(css []string) {
    <!DOCTYPE html>
    <html>
        @Head(css)
        <body>
            <div id="global-error"></div>
            <div class="h-full">
                { children... }
            </div>
        </body>
    </html>

}

templ Head(css []string) {
    <head>
        <title>The Grid</title>
        <script src="https://unpkg.com/htmx.org@2.0.4"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script src="/static/js/app.js"></script>

        <link href="https://cdn.jsdelivr.net/npm/daisyui@latest/dist/full.min.css" rel="stylesheet" type="text/css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"></link>
        <link rel="stylesheet" href="/static/css/tailwind-gen.css"></link>
        <link rel="stylesheet" href="/static/css/app.css"></link>

        for _, c := range css {
            <link rel="stylesheet" href={fmt.Sprintf("/static/css/%s", c)}></link>
        }
    </head>
}
